
## Target environments. Each active environment generates deployment
## artifacts under gen/env/<name>/ and (once) a runtime entry under
## src/env/. Add more with: npx voxgig-system add env <name|spec>
## Kinds: local, basic, docker, vm, aws, azure, cloudflare.

local: { active: true }

# basic: { active: true }
# docker: { active: true }
# vm: { active: true }
# aws: { active: true, region: 'us-east-1', stage: 'dev' }
# azure: { active: true }
## The public agenda read path (Stage 4). The Worker serves published
## snapshots from a KV namespace and carries no Seneca. kv_binding and kv_id
## render into gen/env/cloudflare/wrangler.toml through the project fragment
## tm/env/cloudflare/wrangler.toml.frag, because the package fragment has no
## binding slot. kv_id is the top-level (local) id; under wrangler dev --local
## any id works, and a real deploy of it is refused, because no account holds
## a namespace with that id.
##
## Two deploy targets, one per Cloudflare account, rendered as [env.own] and
## [env.voxgig]. They are flat scalars because only scalar keys become
## fragment slots (@voxgig/build env_gen.js). Account ids are identifiers,
## not credentials. voxgig_domain is the Custom Domain the dashboard shows on
## the voxgig Worker.
cloudflare: {
  active: true
  kv_binding: 'AGENDA'
  kv_id: 'agenda-local'
  own_account_id: '0eea17179e115954177ae5bd5aa2383e'
  own_kv_id: 'e3ca06e60bde4048a41917ea9d1e135e'
  voxgig_account_id: '7bfad364890d882de616c187873a3aee'
  voxgig_kv_id: '9db28d81b53a4de9aff0f79fddd0e00d'
  voxgig_domain: 'agenda.voxgig.com'
}

## The web frontend: the SPA on a browser Seneca bus (PLATFORM 5.3).
##
## Enabled by hand rather than with `voxgig-system add env web`: that CLI
## looks for model.aontu, but this project (like todo-app) uses .aon, which is
## what PLATFORM 1.3 mandates and what @voxgig/create-system generates. The
## CLI's lookup is the odd one out.
web: { active: true }
