
core: name: 'conf-agenda'
core: short: 'conf-agenda'
core: token: 'conf-agenda-auth'

port: &: number

port: {
  backend: 50500
  frontend: 50501
  repl: 50502
}


## Where speaker photos and other files live, relative to backend/. Checked by
## SPEC 16.1's `broken-asset` and `asset-escapes-root` - and containment is
## judged on the CANONICAL path, after resolving symlinks, because a symlink
## inside this root pointing outside it would otherwise be copied into public
## output by a build running in CI.
assets: root: 'assets'
