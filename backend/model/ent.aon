
sys: &: $.main.shape.ent


## Base system entities (used by the user/owner plugins).

sys: user: {
  field: {}
  valid: '$$': 'Open'
}

sys: login: {
  field: {}
  valid: '$$': 'Open'
}


## Application entities. `cag` = conf-agenda; every entity specific to this
## application lives under it (PLATFORM.md 1.2 - never `sys`, and not a
## generic word like `conf` that reads as "config").

cag: &: $.main.shape.ent


## The recursive occasion entity, inherited from metsitaba/fixture-srv's
## core/fixture - see docs/decisions/fixture-model-inheritance.md for the
## field-by-field mapping and every deliberate departure.
##
## A conference IS a fixture; a talk, workshop, panel or break is a fixture
## INSIDE it, via parent_id. Days are not an entity: either a derived
## grouping by local date, or an ordinary intermediate fixture one level
## deeper. The grid, validation and clone all walk the tree and do not care
## how deep it is.

cag: fixture: {
  ux: { view: 'custom' }
  field: {
    id: { label: 'ID' kind: String }

    ## Tenancy and tree position. All four are server-managed, so all four
    ## carry Skip: they are filled AFTER validation runs.
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    ## A top fixture has NO parent_id - the field is ABSENT, not null. SPEC
    ## 8.1's sketch comments "null = top", but the entity validator built from
    ## this model rejects an explicit null in a String field, so absence is the
    ## representation. Tree code tests `null == parent_id`, which covers both.
    parent_id: { label: 'Parent' kind: String ref: 'cag/fixture' valid: Skip }
    top_id: { label: 'Top' kind: String ref: 'cag/fixture' valid: Skip }

    room_id: { label: 'Room' kind: String ref: 'cag/room' valid: Skip }
    track_id: { label: 'Track' kind: String ref: 'cag/track' valid: Skip }

    ## Kind codes constrain the SHAPE of the tree, not just the value:
    ## top kinds have no parent and are the only kinds that may; `day` sits
    ## directly under a top kind; segments sit under a top or a `day` and
    ## contain nothing. Enforced at save time as `bad-parent-kind`.
    ## Top-level: con web mep sem gen | Grouping: day
    ## Segments:  key tak lgt wrk pan brk mea soc reg
    kind: { label: 'Kind' kind: String valid: Skip }

    slug: { label: 'Slug' kind: String valid: Skip }
    title: { label: 'Title' kind: String valid: 'Min(1).Max(300)' }
    desc: { label: 'Abstract' kind: String valid: Skip }

    ## t_ prefix: date/time (fixture-srv convention).
    ## UTC epoch MILLISECONDS - upstream used seconds.
    ## No t_tzo: an offset is derived and DST-dependent, and storing one is
    ## how events drift an hour. The zone NAME is authoritative.
    t_start: { label: 'Start' kind: Number valid: Skip }
    t_end: { label: 'End' kind: Number valid: Skip }
    t_tzn: { label: 'Timezone' kind: String valid: Skip }

    ## p_ prefix: place. Venue lives on the fixture and inherits down the
    ## tree; cag/room covers rooms WITHIN a venue.
    p_name: { label: 'Venue' kind: String valid: Skip }
    p_lat: { label: 'Latitude' kind: Number valid: Skip }
    p_lng: { label: 'Longitude' kind: Number valid: Skip }
    p_gc: { label: 'Geocode' kind: String valid: Skip }
    p_web: { label: 'Venue site' kind: String valid: Skip }

    ## w_ prefix: web links.
    w_site: { label: 'Site' kind: String valid: Skip }
    w_video: { label: 'Video' kind: String valid: Skip }
    w_deck: { label: 'Slides' kind: String valid: Skip }

    ## draft | confirmed | cancelled. Effective status is computed along the
    ## ancestor chain, most restrictive wins - never read this field alone.
    status: { label: 'Status' kind: String valid: Skip }
    private: { label: 'Private' kind: Boolean valid: Skip }
    embed: { label: 'Embed' kind: Object valid: Skip }

    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


cag: room: {
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    name: { label: 'Name' kind: String valid: 'Min(1).Max(200)' }
    capacity: { label: 'Capacity' kind: Number valid: Skip }
    floor: { label: 'Floor' kind: String valid: Skip }
    access: { label: 'Accessibility' kind: String valid: Skip }
    ## Column order in the agenda grid.
    order: { label: 'Order' kind: Number valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


cag: track: {
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    name: { label: 'Name' kind: String valid: 'Min(1).Max(200)' }
    ## Per-track accent, organiser data rather than theme. Must pass WCAG AA
    ## against both theme modes at validation time (`bad-color-contrast`).
    color: { label: 'Colour' kind: String valid: Skip }
    desc: { label: 'Description' kind: String valid: Skip }
    order: { label: 'Order' kind: Number valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


## Org-scoped, NOT fixture-scoped: a speaker at the 2026 and 2027 editions is
## one person with one bio and one email. cag/appearance ties them to a
## segment. email is never public (C6) - stripped structurally, not by field
## selection.

cag: speaker: {
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    name: { label: 'Name' kind: String valid: 'Min(1).Max(200)' }
    ## Empty, not Skip. `Skip` lets the field be ABSENT but still rejects an
    ## empty string - so a form that clears the box cannot save, and a speaker
    ## with no address is exactly the state the `speaker-no-email` warning
    ## (SPEC 16.2) exists to report. A rule about a missing value needs the
    ## missing value to be storable.
    email: { label: 'Email' kind: String valid: 'Empty' }
    bio: { label: 'Bio' kind: String valid: Skip }
    photo: { label: 'Photo' kind: String valid: Skip }
    org_name: { label: 'Organisation' kind: String valid: Skip }
    w_site: { label: 'Site' kind: String valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


## The join: one speaker appearing on one segment fixture, carrying role and
## invitation state. `presents` / `presentedBy` in the ontology.

cag: appearance: {
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    fixture_id: { label: 'Segment' kind: String ref: 'cag/fixture' valid: Skip }
    speaker_id: { label: 'Speaker' kind: String ref: 'cag/speaker' valid: Skip }
    ## speaker | host | panellist | mentor
    role: { label: 'Role' kind: String valid: Skip }
    ## none | sent | accepted | declined | tentative | cancelled
    invite: { label: 'Invitation' kind: String valid: Skip }
    order: { label: 'Order' kind: Number valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


## The published snapshot. Everything public reads THIS - nothing public ever
## reaches the live entity rows (SPEC 9.1). Locally this is an ordinary entity;
## at Stage 4 the same write moves to Cloudflare KV. One deployment seam, no
## application change.
##
## id is '<org_id>:<slug>', so the public read is a load by id.

## ---------------------------------------------------------------------------
## THE SYNC LEDGER (SPEC 10.3). `sys/` and not `cag/`, because this is the
## extension of @seneca/calendar rather than conference data - it is destined
## for senecajs/Calendar, and the namespace is what makes that a move rather
## than a rename (SPEC 10.1).

## A connected calendar. Carries a SECRET NAME, never token material (C7):
## the value lives in sekreto and exists only at the SDK transport seam.
sys: calendar_account: {
  ux: { label: 'name' }
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    name: { label: 'Name' kind: String valid: 'Min(1).Max(200)' }
    ## google | microsoft | caldav | zoho | ics | fake
    provider: { label: 'Provider' kind: String valid: Skip }
    ## The provider's own id for the chosen calendar. EMPTY is legitimate:
    ## provider:ics has no calendar to choose - the mail IS the event.
    calendar_id: { label: 'Calendar' kind: String valid: 'Empty' }
    ## A sekreto NAME. If a token ever appears in this row, C7 has been
    ## broken - the row is readable by anything that can read the org.
    ## Empty for provider:ics, which has no credentials at all, and that is
    ## part of why it is the always-available fallback (SPEC 10.2).
    secret_ref: { label: 'Secret' kind: String valid: 'Empty' }
    status: { label: 'Status' kind: String valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


## ONE ROW PER (segment fixture x account). Generalises the upstream outbox's
## discipline - one row per identity, upserted in place - from notification
## stages to provider events (SPEC 10.1, 10.3).
##
## NEVER DELETED. A cancelled link is a tombstone, and the tombstone is what
## stops a resurrection creating a duplicate.
sys: calendar_link: {
  ux: { label: 'uid' }
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    fixture_id: { label: 'Segment' kind: String ref: 'cag/fixture' valid: Skip }
    ## Denormalised ON PURPOSE. Reconciliation scopes by top_id rather than by
    ## walking the live tree, so links whose fixtures have vanished are still
    ## found and still cancelled - a resolver that discovers events through
    ## surviving parent_id chains loses exactly the events whose ancestors
    ## were deleted, which is the C8 failure. An orphaned event is a meeting a
    ## speaker still turns up to.
    top_id: { label: 'Conference' kind: String ref: 'cag/fixture' valid: Skip }
    account_id: { label: 'Account' kind: String ref: 'sys/calendar_account' valid: Skip }
    provider_event_id: { label: 'Provider event' kind: String valid: Skip }
    ## Stable iCal UID: <fixture-id>@<top-slug>. Same UID forever, so a change
    ## is an update in the speaker's calendar and never a second entry (C3).
    uid: { label: 'UID' kind: String valid: Skip }
    sequence: { label: 'Sequence' kind: Number valid: Skip }
    ## Hash of the EventSpec - and the spec covers ONLY what a speaker would
    ## notice about a live event. See src/lib/eventspec.ts for why that
    ## narrowness is load-bearing.
    content_hash: { label: 'Hash' kind: String valid: Skip }
    ## The spec the hash was taken of, frozen. The hash answers "did anything
    ## change"; only the spec itself answers "WHAT changed" - and the sync plan
    ## has to tell the organiser "room + start time", not "hash differs"
    ## (mockups/src/SyncPlan.dc.html).
    spec_json: { label: 'Spec' kind: String valid: 'Empty' }
    ## active | cancelled
    state: { label: 'State' kind: String valid: Skip }
    last_sync: { label: 'Last sync' kind: Number valid: Skip }
    ## Empty, not Skip: the generated validator rejects BOTH an explicit null
    ## and an empty string in a plain String field, and "no error" has to be
    ## expressible - otherwise a link that once failed carries that failure
    ## for ever, and the console shows an error against a link that is fine.
    last_error: { label: 'Last error' kind: String valid: 'Empty' }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


## A sync RUN. Sync goes through a queue, not the request (SPEC 10.6), so the
## organiser sees per-segment state rather than a spinner - and a crash
## resumes instead of starting over.
##
## An active run for a top fixture IS the durable half of C10: the in-process
## advisory lock makes the check-and-create atomic, but only a row survives a
## restart, and "one sync at a time per conference" has to survive one.
sys: calendar_run: {
  ux: { label: 'top_id' }
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    top_id: { label: 'Conference' kind: String ref: 'cag/fixture' valid: Skip }
    ## running | done | aborted
    state: { label: 'State' kind: String valid: Skip }
    t_start: { label: 'Started' kind: Number valid: Skip }
    t_end: { label: 'Ended' kind: Number valid: Skip }
    ## Counts by action, as a frozen JSON string - the same reasoning as
    ## cag/snapshot.agenda_json: bytes are what a store preserves.
    counts_json: { label: 'Counts' kind: String valid: 'Empty' }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


## ONE JOB PER (segment fixture x account). That granularity is the point: a
## single provider rejection is isolated and retriable without touching the
## other speakers (SPEC 10.6, C9).
sys: calendar_job: {
  ux: { label: 'uid' }
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    run_id: { label: 'Run' kind: String ref: 'sys/calendar_run' valid: Skip }
    top_id: { label: 'Conference' kind: String ref: 'cag/fixture' valid: Skip }
    fixture_id: { label: 'Segment' kind: String valid: Skip }
    account_id: { label: 'Account' kind: String ref: 'sys/calendar_account' valid: Skip }
    ## create | update | cancel
    action: { label: 'Action' kind: String valid: Skip }
    uid: { label: 'UID' kind: String valid: Skip }
    ## The decided PlanItem, frozen at enqueue time. The job carries what was
    ## confirmed (C4), so a plan that changes mid-run cannot quietly alter what
    ## the organiser agreed to send.
    item_json: { label: 'Item' kind: String valid: 'Empty' }
    ## pending | sent | noop | failed | abandoned
    state: { label: 'State' kind: String valid: Skip }
    attempts: { label: 'Attempts' kind: Number valid: Skip }
    ## Earliest next try. Backoff is exponential WITH JITTER, so a provider
    ## that rejected a hundred jobs at once does not get all hundred retries
    ## back in the same instant.
    next_at: { label: 'Next attempt' kind: Number valid: Skip }
    last_error: { label: 'Last error' kind: String valid: 'Empty' }
    ## How long the provider took, in ms. Shown per segment on the run screen:
    ## "sent" means the provider accepted it, and how long that took is the
    ## first thing anyone asks when a sync feels slow.
    ms: { label: 'Duration' kind: Number valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}


cag: snapshot: {
  ## Without this the app picks the first non-ref String field in key order -
  ## `agenda_json` - and renders the entire published document as the page
  ## heading. The slug is what a human calls this row.
  ux: { label: 'slug' }
  field: {
    id: { label: 'ID' kind: String }
    org_id: { label: 'Org' kind: String ref: 'sys/org' valid: Skip }
    top_id: { label: 'Conference' kind: String ref: 'cag/fixture' valid: Skip }
    slug: { label: 'Slug' kind: String valid: Skip }
    schema_version: { label: 'Schema' kind: Number valid: Skip }
    ## When this snapshot was written. Deliberately OUTSIDE the agenda payload:
    ## agenda.json must be byte-identical for identical input (SPEC 17), and a
    ## publish timestamp inside it would change on every publish.
    published_at: { label: 'Published' kind: Number valid: Skip }
    ## Stored as a STRING, not an object. The snapshot is a frozen document:
    ## SPEC 17 requires agenda.json to be byte-identical for identical input,
    ## and bytes are what a string preserves - an object round-tripped through
    ## a store can come back with a different key order. It is also what
    ## Cloudflare KV holds natively, so Stage 4 moves the write without
    ## reshaping the data.
    agenda_json: { label: 'Agenda' kind: String valid: Skip }
    t_c: { label: 'Created' kind: Number valid: Skip }
    t_m: { label: 'Modified' kind: Number valid: Skip }
  }
  valid: '$$': 'Open'
}
