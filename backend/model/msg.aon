
# Seneca message patterns.
#
# main.msg is a LIST of definitions, each carrying its pattern as DATA - an
# ordered list of single-pair maps - rather than as its position in a nested
# tree (PLATFORM 1.4). A list and not a map keyed by name, because a gateway
# proxy and the message it forwards to necessarily share their LAST pattern
# pair, and any key derived from that pair would collide.
#
# The action file comes from the last pattern pair (validate:fixture ->
# validate_fixture.ts), with `file` overriding it - which is what a proxy
# needs. Only declare a message whose action file EXISTS (PLATFORM 1.2).
#
# The browser surface is aim:web and nothing else, declared as web_ proxies
# here and allowed in srv.aon. None exist yet: there is no frontend.

[

  # ---- cag service -------------------------------------------------------
  # Validation, publication and the segment intents. Entity operations stay
  # internal, behind these (SPEC 9 - there is no generic ent service).

  { pat: [{aim: cag}, {validate: fixture}]
    params: { fixture_id: 'String' } }

  { pat: [{aim: cag}, {publish: fixture}]
    params: { fixture_id: 'String' } }

  # The organiser's read. NOT the public snapshot: the app must show drafts,
  # which agenda.json deliberately never contains.
  { pat: [{aim: cag}, {load: tree}]
    params: { fixture_id: 'Skip(String)' } }

  # The calendar sync plan (SPEC 10.3). READ-ONLY and sends nothing - C4's
  # dry-run is the default, and `apply` is a separate, confirmed message that
  # does not exist on this surface yet. The app calls this; the work happens in
  # sys:calendar, which has no aim: surface of its own.
  { pat: [{aim: cag}, {plan: sync}]
    params: { fixture_id: 'String' } }

  # Applying reaches real speakers, so `confirm` is REQUIRED on this surface -
  # C4's "explicit confirmation stating the invitation and recipient counts".
  # It enqueues; the queue sends (SPEC 10.6).
  { pat: [{aim: cag}, {apply: sync}]
    params: { fixture_id: 'String', confirm: 'Boolean' } }

  # ---- the segment intents (SPEC 9) --------------------------------------
  # Every grid interaction is a NAMED INTENT with its own closed params shape.
  # The browser never composes an entity and never computes the new row - the
  # result of a drag is an intent, not a payload (PLATFORM 1.2).
  #
  # NOTE WHAT IS ABSENT: no definition below declares org_id, owner_id or
  # top_id. Tenancy comes from the STORED row, and the closed shape is the
  # structural half of that - there is no key to send.
  #
  # `inverse` is the declared undo contract (PLATFORM 1.4). It names its
  # target BY PATTERN, and `map` says how that message's params are built from
  # this one's params and result. Undo runs the inverse as an ORDINARY EDIT,
  # which the ledger, the validator and the audit trail all see like any
  # other - not a snapshot restore, which would put back state the server may
  # have moved on from.
  #
  # `inverse` is stripped from the model before the Lambda generators see it
  # (build/msg_meta.js) - @voxgig/build's MsgMetaShape is closed and rejects
  # it, and the failure is a FALSE GREEN. model.json keeps it, which is what
  # the SPA reads.

  { pat: [{aim: cag}, {move: segment}]
    params: { fixture_id: 'String', room_id: 'Skip(String)', t_start: 'Number' }
    inverse: { pat: [{aim: cag}, {move: segment}]
               map: { fixture_id: 'params.fixture_id'
                      room_id: 'result.prev.room_id'
                      t_start: 'result.prev.t_start' } } }

  { pat: [{aim: cag}, {set: status}]
    params: { fixture_id: 'String', status: 'String' }
    inverse: { pat: [{aim: cag}, {set: status}]
               map: { fixture_id: 'params.fixture_id'
                      status: 'result.prev.status' } } }

  { pat: [{aim: cag}, {make: segment}]
    params: { parent_id: 'String', t_start: 'Number', t_end: 'Number'
              room_id: 'Skip(String)', kind: 'Skip(String)', title: 'Skip(String)' }
    inverse: { pat: [{aim: cag}, {remove: segment}]
               map: { fixture_id: 'result.fixture_id' } } }

  # SPEC 9: duplicate "declares the removal of the copy" as its inverse -
  # which is why remove:segment is declared at all. PLATFORM 1.4 requires an
  # inverse.pat to match a DECLARED definition.
  { pat: [{aim: cag}, {duplicate: segment}]
    params: { fixture_id: 'String' }
    inverse: { pat: [{aim: cag}, {remove: segment}]
               map: { fixture_id: 'result.fixture_id' } } }

  # NO INVERSE, deliberately. Restoring a deleted segment is not an ordinary
  # edit, and PLATFORM 1.4 says a definition without one "is not undoable, and
  # the UI must show it that way".
  { pat: [{aim: cag}, {remove: segment}]
    params: { fixture_id: 'String' } }

  { pat: [{aim: cag}, {add: appearance}]
    params: { fixture_id: 'String', speaker_id: 'String', role: 'Skip(String)' }
    inverse: { pat: [{aim: cag}, {remove: appearance}]
               map: { appearance_id: 'result.appearance_id' } } }

  { pat: [{aim: cag}, {remove: appearance}]
    params: { appearance_id: 'String' }
    inverse: { pat: [{aim: cag}, {add: appearance}]
               map: { fixture_id: 'result.prev.fixture_id'
                      speaker_id: 'result.prev.speaker_id'
                      role: 'result.prev.role' } } }


  # Per-segment progress for one run. Read-only, and deliberately NOT named
  # `get:` - see web_watch_run.ts. A run's state changes on the server with no
  # client write to invalidate a cache, so it must never be treated as a
  # cacheable read.
  { pat: [{aim: cag}, {watch: run}]
    params: { run_id: 'String' } }


  # ---- browser surface ---------------------------------------------------
  # aim:web is the ONLY namespace the gateway accepts from a browser. Each
  # entry is a declared proxy to a real service message; a proxy shares its
  # LAST pattern pair with the message it forwards to, so it names its own
  # action file (PLATFORM 1.4).

  { pat: [{aim: web}, {on: cag}, {load: tree}]
    file: './web_load_tree' }

  { pat: [{aim: web}, {on: cag}, {plan: sync}]
    file: './web_plan_sync' }

  { pat: [{aim: web}, {on: cag}, {apply: sync}]
    file: './web_apply_sync' }

  { pat: [{aim: web}, {on: cag}, {watch: run}]
    file: './web_watch_run' }

  # The grid re-runs validation after every settled intent, for the header's
  # error count - live validation (SPEC 19.4), minus the panel.
  { pat: [{aim: web}, {on: cag}, {validate: fixture}]
    file: './web_validate_fixture' }

  # The segment intents. Each is a declared proxy, and each names its own
  # action file because a proxy shares its LAST pattern pair with the message
  # it forwards to (PLATFORM 1.4).
  { pat: [{aim: web}, {on: cag}, {move: segment}]
    file: './web_move_segment' }

  { pat: [{aim: web}, {on: cag}, {set: status}]
    file: './web_set_status' }

  { pat: [{aim: web}, {on: cag}, {make: segment}]
    file: './web_make_segment' }

  { pat: [{aim: web}, {on: cag}, {duplicate: segment}]
    file: './web_duplicate_segment' }

  { pat: [{aim: web}, {on: cag}, {remove: segment}]
    file: './web_remove_segment' }

  { pat: [{aim: web}, {on: cag}, {add: appearance}]
    file: './web_add_appearance' }

  { pat: [{aim: web}, {on: cag}, {remove: appearance}]
    file: './web_remove_appearance' }


  # ---- agenda service ----------------------------------------------------
  # The public read path. aim:agenda,get:agenda is the ONE unauthenticated
  # message (SPEC 9.1): the embed runs on a third party's page and cannot
  # carry credentials.

  { pat: [{aim: agenda}, {get: agenda}]
    params: { org_id: 'String', slug: 'String' } }

  # Feeds, derived from the same snapshot: .ics to subscribe, .csv to export.
  { pat: [{aim: agenda}, {get: feed}]
    params: { org_id: 'String', slug: 'String', format: 'Skip(String)' } }

  # ---- auth service ------------------------------------------------------
  # Session and user settings, thin wrappers over @seneca/user. SPEC 19.3
  # runs Stage 1 behind a login. Shape follows todo-app's own msg.aon.

  { pat: [{aim: auth}, {get: info}] }
  { pat: [{aim: auth}, {signin: user}] }
  { pat: [{aim: auth}, {signout: user}] }
  { pat: [{aim: auth}, {load: auth}] }
  { pat: [{aim: auth}, {change: pass}] }
  { pat: [{aim: auth}, {update: user}] }
  { pat: [{aim: auth}, {remind: pass}] }
  { pat: [{aim: auth}, {create: apikey}] }
  { pat: [{aim: auth}, {list: apikey}] }
  { pat: [{aim: auth}, {revoke: apikey}] }

  { pat: [{aim: web}, {on: auth}, {signin: user}],   file: './web_signin_user' }
  { pat: [{aim: web}, {on: auth}, {signout: user}],  file: './web_signout_user' }
  { pat: [{aim: web}, {on: auth}, {load: auth}],     file: './web_load_auth' }
  { pat: [{aim: web}, {on: auth}, {change: pass}],   file: './web_change_pass' }
  { pat: [{aim: web}, {on: auth}, {update: user}],   file: './web_update_user' }
  { pat: [{aim: web}, {on: auth}, {remind: pass}],   file: './web_remind_pass' }
  { pat: [{aim: web}, {on: auth}, {create: apikey}], file: './web_create_apikey' }
  { pat: [{aim: web}, {on: auth}, {list: apikey}],   file: './web_list_apikey' }
  { pat: [{aim: web}, {on: auth}, {revoke: apikey}], file: './web_revoke_apikey' }


  # ---- per-entity reads --------------------------------------------------
  # One message per entity and verb, with the entity named by the PATTERN
  # rather than carried as data - never a generic canon-plus-item surface
  # (SPEC 9, PLATFORM 1.2). Same shape todo-app uses.
  #
  # READ ONLY at Stage 1. Writes arrive at Stage 2 as per-field intents
  # (update:speaker with exactly the editable fields), which is a shape
  # decision this stage does not need to make.

  { pat: [{aim: cag}, {list: room}] }
  { pat: [{aim: cag}, {load: room}], params: { id: 'String' } }
  { pat: [{aim: cag}, {list: track}] }
  { pat: [{aim: cag}, {load: track}], params: { id: 'String' } }
  { pat: [{aim: cag}, {list: speaker}] }
  { pat: [{aim: cag}, {load: speaker}], params: { id: 'String' } }
  { pat: [{aim: cag}, {list: appearance}] }
  { pat: [{aim: cag}, {load: appearance}], params: { id: 'String' } }
  { pat: [{aim: cag}, {list: snapshot}] }
  { pat: [{aim: cag}, {load: snapshot}], params: { id: 'String' } }

  { pat: [{aim: web}, {on: cag}, {list: room}], file: './web_list_room' }
  { pat: [{aim: web}, {on: cag}, {load: room}], file: './web_load_room' }
  { pat: [{aim: web}, {on: cag}, {list: track}], file: './web_list_track' }
  { pat: [{aim: web}, {on: cag}, {load: track}], file: './web_load_track' }
  { pat: [{aim: web}, {on: cag}, {list: speaker}], file: './web_list_speaker' }
  { pat: [{aim: web}, {on: cag}, {load: speaker}], file: './web_load_speaker' }
  { pat: [{aim: web}, {on: cag}, {list: appearance}], file: './web_list_appearance' }
  { pat: [{aim: web}, {on: cag}, {load: appearance}], file: './web_load_appearance' }
  { pat: [{aim: web}, {on: cag}, {list: snapshot}], file: './web_list_snapshot' }
  { pat: [{aim: web}, {on: cag}, {load: snapshot}], file: './web_load_snapshot' }

]
