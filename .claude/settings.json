{
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Read(**/local-env.*)",
      "Edit(**/local-env.*)",
      "Write(**/local-env.*)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Write(**/.npmrc)",
      "Read(**/settings.local.json)",
      "Edit(**/settings.local.json)",
      "Write(**/settings.local.json)",
      "Bash(cat *local-env*)",
      "Bash(cat *.npmrc*)",
      "Bash(cat *settings.local.json*)",
      "Bash(head *local-env*)",
      "Bash(head *.npmrc*)",
      "Bash(head *settings.local.json*)",
      "Bash(tail *local-env*)",
      "Bash(tail *.npmrc*)",
      "Bash(tail *settings.local.json*)",
      "Bash(less *local-env*)",
      "Bash(less *.npmrc*)",
      "Bash(less *settings.local.json*)",
      "Bash(more *local-env*)",
      "Bash(more *.npmrc*)",
      "Bash(more *settings.local.json*)",
      "Bash(grep *local-env*)",
      "Bash(grep *.npmrc*)",
      "Bash(grep *settings.local.json*)",
      "Bash(sed *local-env*)",
      "Bash(sed *.npmrc*)",
      "Bash(sed *settings.local.json*)",
      "Bash(awk *local-env*)",
      "Bash(awk *.npmrc*)",
      "Bash(awk *settings.local.json*)",
      "Bash(xxd *local-env*)",
      "Bash(xxd *.npmrc*)",
      "Bash(xxd *settings.local.json*)",
      "Bash(od *local-env*)",
      "Bash(od *.npmrc*)",
      "Bash(od *settings.local.json*)",
      "Bash(strings *local-env*)",
      "Bash(strings *.npmrc*)",
      "Bash(strings *settings.local.json*)",
      "Bash(base64 *local-env*)",
      "Bash(base64 *.npmrc*)",
      "Bash(base64 *settings.local.json*)",
      "Bash(cp *local-env*)",
      "Bash(cp *.npmrc*)",
      "Bash(cp *settings.local.json*)",
      "Bash(mv *local-env*)",
      "Bash(mv *.npmrc*)",
      "Bash(mv *settings.local.json*)",
      "Bash(ln *local-env*)",
      "Bash(ln *.npmrc*)",
      "Bash(ln *settings.local.json*)",
      "Bash(tee *local-env*)",
      "Bash(tee *.npmrc*)",
      "Bash(tee *settings.local.json*)",
      "Bash(tar *local-env*)",
      "Bash(tar *.npmrc*)",
      "Bash(tar *settings.local.json*)",
      "Bash(rsync *local-env*)",
      "Bash(rsync *.npmrc*)",
      "Bash(rsync *settings.local.json*)",
      "Bash(env *local-env*)",
      "Bash(env *.npmrc*)",
      "Bash(env *settings.local.json*)",
      "Bash(xargs *local-env*)",
      "Bash(xargs *.npmrc*)",
      "Bash(xargs *settings.local.json*)"
    ]
  }
}
